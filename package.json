{
  "name": "resume-builder",
  "version": "0.1.0",
  "private": true,
  "description": "AI-powered resume builder with templates, PDF import/export, BYOK AI and ATS scoring",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "setup": "node scripts/setup.mjs && prisma db push",
