// Database schema for the resume builder (PostgreSQL, e.g. Neon via the Vercel Marketplace).
// DATABASE_URL is the pooled connection used by the app; DATABASE_URL_UNPOOLED is
// the direct connection Prisma needs for schema changes (`prisma db push`).
// Vercel's Neon integration sets both automatically.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model User {
  id                String         @id @default(cuid())
  email             String         @unique
  name              String?
  image             String?
  // Null for accounts created only through OAuth.
  passwordHash      String?
  // Incremented to invalidate all existing sessions (e.g. password change).
  tokenVersion      Int            @default(0)
  // Which BYOK provider to prefer when several keys are configured.
  preferredProvider String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  resumes  Resume[]
  apiKeys  ApiKey[]
  accounts OAuthAccount[]
  aiUsage  AiUsage[]
}

model OAuthAccount {
  id                String   @id @default(cuid())
  provider          String
  providerAccountId String
  userId            String
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Resume {
  id             String   @id @default(cuid())
  userId         String
  title          String
  template       String   @default("modern")
  // Serialized ResumeData JSON (see src/lib/resume/schema.ts).
  data           String
  // Target job description used for ATS matching.
  jobDescription String?
  // Last computed ATS score (0-100).
  atsScore       Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
}

model ApiKey {
  id           String   @id @default(cuid())
  userId       String
  // anthropic | openai | gemini
  provider     String
  // AES-256-GCM ciphertext: base64(iv).base64(tag).base64(ciphertext)
  encryptedKey String
  // Last four characters, for display only.
  last4        String
  // Optional per-user model override.
  model        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider])
}

model AiUsage {
  id     String @id @default(cuid())
  userId String
  // UTC day, YYYY-MM-DD
  day    String
  count  Int    @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, day])
}
