# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# Public URL of the app (used for OAuth callbacks).
APP_URL="http://localhost:3000"

# PostgreSQL. On Vercel, Storage → Create Database → Neon sets both of these
# automatically. For local development, copy them from the Neon dashboard
# (ideally a separate "dev" branch) or use a local Postgres.
# Pooled connection, used by the app:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
# Direct (unpooled) connection, used by `prisma db push`:
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Secret used to sign session tokens. Generate: openssl rand -base64 32
AUTH_SECRET=""

# Secret used to encrypt users' API keys at rest (AES-256-GCM).
# Generate: openssl rand -base64 32. Changing it makes stored keys unreadable.
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Platform ("base") AI - used for users who have not added their own key.
# Leave all keys empty to run with the built-in offline writing assistant.
# ---------------------------------------------------------------------------
# One of: openrouter | anthropic | openai | gemini
PLATFORM_AI_PROVIDER="openrouter"
# OpenRouter (https://openrouter.ai/settings/keys): one key, many models.
OPENROUTER_API_KEY=""
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# Optional model overrides (OpenRouter uses "vendor/model" IDs)
OPENROUTER_MODEL="anthropic/claude-sonnet-5.5"
ANTHROPIC_MODEL="claude-opus-5-5"
OPENAI_MODEL="gpt-5-mini"
GEMINI_MODEL="gemini-2.5-flash"

# Max platform AI requests per user per day (BYOK users are not limited).
PLATFORM_AI_DAILY_LIMIT="25"

# ---------------------------------------------------------------------------
# Optional OAuth providers (buttons appear only when configured)
# Callback URLs:
#   Google: {APP_URL}/api/auth/oauth/google/callback
#   GitHub: {APP_URL}/api/auth/oauth/github/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
